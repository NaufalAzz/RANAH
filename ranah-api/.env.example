APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Use exact browser origins; set the public web origin in production.
RANAH_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# For production, append each exact HTTPS web origin, for example: https://ranah.example.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# BMKG polling cadences. The Windows/Laragon scheduler must invoke schedule:run every minute.
BMKG_EARTHQUAKE_CRON="*/5 * * * *"
BMKG_WEATHER_ALERT_CRON="*/5 * * * *"
BMKG_FORECAST_CRON="15 0,12 * * *"
BMKG_FORECAST_TIMEZONE="Asia/Jakarta"
BMKG_FORECAST_CACHE_HOURS=48
BMKG_FORECAST_STALE_HOURS=18
# JSON list is intentionally empty until each ADM4 code/name pair is checked against
# a current official Kemendagri administrative-code publication. Never infer adm4 from a street address.
BMKG_WEATHER_ADM4_AREAS="[]"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional server-side OpenRouteService key for academic foot-walking route simulation.
# Never expose this key to Flutter Web. Leave empty to disable route calculations.
ORS_API_KEY=

# Academic demo only; this public service is not for production or emergency use.
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
VALHALLA_CLIENT_ID=RANAH-AcademicPrototype/1.0
